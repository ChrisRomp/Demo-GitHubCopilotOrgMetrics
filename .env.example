# Required
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem
GITHUB_ORG=YOUR_ORG

# Optional
# If you're on dedicated subdomain GHE.com, set this (example): https://api.SUBDOMAIN.ghe.com
GITHUB_API_BASE_URL=https://api.github.com

# Optional override (if you already know it)
# GITHUB_INSTALLATION_ID=12345678
